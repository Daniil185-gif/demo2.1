function renderTariffs(){
  let h = '<h1 class="h1s">Тарифы</h1><p class="note">Цены ориентировочные: итог согласует мастер после разговора.</p>';
  Object.keys(CONFIG.prices).forEach(c => {
    const mat = c === "mattress";
    h += '<div class="tcat">' + ICON[c] + "<span>" + CATS[c].name + '</span></div><div class="tw"><table><tr><th>Вариант</th><th>Цена</th><th>Сильные загрязнения</th>' + (mat ? "<th>Обе стороны</th>" : "") + "</tr>"
      + CATS[c].vars.map(v => "<tr><td>" + v[1] + "</td><td>" + rub(unitPrice({cat: c, v: v[0]})) + "</td><td>" + rub(unitPrice({cat: c, v: v[0], heavy: true})) + "</td>" + (mat ? "<td>" + rub(unitPrice({cat: c, v: v[0], side2: true})) + "</td>" : "") + "</tr>").join("") + "</table></div>";
  });
  $("tar").innerHTML = h + '<p class="note" style="margin-top:16px">Минимальный заказ на чистку: ' + rub(CONFIG.minOrder) + ". Выезд за город: +" + rub(CONFIG.outTown) + ". Предметы из раздела «Другое» оцениваются по фото.</p>";
}

// ---------- Кабинет владельца (демо в браузере) ----------
const ST = {new: "Новая", agreed: "Согласована", done: "Завершена", cancelled: "Отменена"}, RK = KEY + ":reqs";
let cab = {tab: "reqs", q: "", s: "all"};
function getReqs(){ try { return JSON.parse(localStorage.getItem(RK) || "[]"); } catch(e){ return []; } }
function putReqs(a){ try { localStorage.setItem(RK, JSON.stringify(a)); } catch(e){} }
function authed(){ try { return sessionStorage.getItem(KEY + ":auth") === "1"; } catch(e){ return false; } }
function reqCard(r){
  const photos = Array.isArray(r.photos) && r.photos.length ? '<div class="photo-grid owner-photos">' + r.photos.map((src,i)=>'<a href="' + esc(src) + '" target="_blank" rel="noopener"><img src="' + esc(src) + '" alt="Фото клиента ' + (i+1) + '"></a>').join("") + '</div>' : '<div class="note">Фотографии не приложены</div>';
  const created = r.createdAt ? new Date(r.createdAt).toLocaleString("ru-RU") : (r.hist && r.hist[0] ? r.hist[0] : "Дата не указана");
  const wanted = (r.date || "Дата не указана") + " · " + (r.time || "Время не указано");
  const itemDetails = (r.items || []).map(it => '<li>' + esc(itemLabel(it)) + (it.cat === "other" ? "" : " — " + esc(it.qty) + " шт.") + '</li>').join("");
  return '<div class="rq" data-id="' + esc(r.id) + '"><div class="row" style="margin:0"><b>Заявка от ' + esc(created) + '</b><span class="badge2">' + (ST[r.status] || "Новая") + '</span></div>'
    + '<div class="rq-section"><b>Контакты клиента</b><div>Имя: ' + esc(r.name) + '</div><div>Телефон: ' + esc(r.phone) + '</div><div>Адрес выезда: ' + esc(r.addr) + '</div><div>Выезд за город: ' + (r.out ? "Да" : "Нет") + '</div></div>'
    + '<div class="rq-section"><b>Когда клиенту удобно</b><div>' + esc(wanted) + '</div><small>Это пожелание клиента, не подтверждённая запись.</small></div>'
    + '<div class="rq-section"><b>Что выбрал клиент</b><ul>' + itemDetails + '</ul><div>Предварительная стоимость: <b>' + esc(r.est) + '</b></div></div>'
    + '<div class="rq-section"><b>Фотографии</b>' + photos + '</div>'
    + '<div class="rq-section"><b>Комментарий клиента</b><div>' + (r.comm ? esc(r.comm) : "Не оставлен") + '</div></div>'
    + '<div class="grid2"><label class="field"><span>Итоговая цена, ₽</span><input type="number" min="0" data-f="final" value="' + esc(r.final) + '"></label><label class="field"><span>Согласованное время</span><input type="datetime-local" data-f="at" value="' + esc(r.at) + '"></label></div>'
    + '<label class="field"><span>Статус</span><select data-f="status">' + Object.keys(ST).map(k => '<option value="' + k + '"' + (k === r.status ? " selected" : "") + ">" + ST[k] + "</option>").join("") + "</select></label>"
    + '<label class="field"><span>Заметка (видна только владельцу)</span><textarea data-f="note">' + esc(r.note) + "</textarea></label>"
    + '<small class="err" data-e></small><div class="row"><button class="btn pri sm" data-a="save">Сохранить</button><button class="btn sm" data-a="del">Удалить</button></div>'
    + '<div class="note">' + (r.hist || []).map(esc).join("<br>") + '</div></div>';
}
function renderList(){
  const q = (cab.q || "").toLowerCase(), a = getReqs().filter(r => (cab.s === "all" || r.status === cab.s) && (!q || (r.name + r.phone + r.addr).toLowerCase().includes(q)));
  $("cabCount").textContent = "Заявок: " + a.length;
  $("cabList").innerHTML = a.length ? a.map(reqCard).join("") : '<p class="note">Заявок нет. Отправьте заявку на странице «Заявка», и она появится здесь.</p>';
}
function tariffForm(){
  let h = '<div class="grid2">';
  Object.keys(CONFIG.prices).forEach(c => CATS[c].vars.forEach(v => h += '<label class="field"><span>' + CATS[c].name + ", " + v[1] + ', ₽</span><input type="number" min="0" data-p="' + c + "." + v[0] + '" value="' + CONFIG.prices[c][v[0]] + '"></label>'));
  [["minOrder", "Минимальный заказ, ₽"], ["outTown", "Выезд за город, ₽"], ["heavyPct", "Сильные загрязнения, %"], ["secondSidePct", "Вторая сторона матраса, %"]].forEach(x => h += '<label class="field"><span>' + x[1] + '</span><input type="number" min="0" data-p="' + x[0] + '" value="' + CONFIG[x[0]] + '"></label>');
  return h + '</div><small class="err" id="tarErr"></small><div class="row"><button class="btn pri" data-a="saveTar">Сохранить тарифы</button></div><p class="note">Изменения сразу применяются к расчёту в этом браузере. Чтобы новые цены увидели все посетители сайта с разных устройств, потребуется подключить серверное хранилище.</p>';
}
const COF = [["company", "Название"], ["city", "Город"], ["tagline", "Короткое описание"], ["contacts", "Контакты (телефон, мессенджер)"]];
function renderCabinet(){
  const box = $("cab");
  if (!authed()) {
    box.innerHTML = '<h1 class="h1s">Кабинет</h1><p class="note">Демо-вход: пароль проверяется в браузере и не защищает данные. В версии с сервером вход проверяет сервер. Пароль по умолчанию: owner.</p><label class="field"><span>Пароль</span><input type="password" id="cabPass" autocomplete="current-password"></label><small class="err" id="cabErr"></small><div class="row"><button class="btn pri" data-a="login">Войти</button></div>';
    return;
  }
  box.innerHTML = '<div class="tabs2">' + [["reqs", "Заявки"], ["tar", "Тарифы"], ["co", "Компания"]].map(x => '<button class="tab" data-tab="' + x[0] + '" aria-pressed="' + (cab.tab === x[0]) + '">' + x[1] + "</button>").join("") + '<button class="tab" data-a="logout">Выйти</button></div><div id="cabBody"></div>';
  const b = $("cabBody");
  if (cab.tab === "reqs") {
    b.innerHTML = '<div class="grid2"><label class="field"><span>Поиск</span><input type="text" id="cabQ" value="' + esc(cab.q) + '"></label><label class="field"><span>Статус</span><select id="cabS"><option value="all">Все</option>' + Object.keys(ST).map(k => '<option value="' + k + '">' + ST[k] + "</option>").join("") + '</select></label></div><div class="row"><span class="note" id="cabCount"></span><button class="btn sm" data-a="refresh">Обновить список</button></div><div id="cabList"></div>';
    $("cabS").value = cab.s; renderList();
  } else if (cab.tab === "tar") b.innerHTML = tariffForm();
  else b.innerHTML = COF.map(x => '<label class="field"><span>' + x[1] + '</span><input type="text" data-c="' + x[0] + '" value="' + esc(CONFIG[x[0]]) + '"></label>').join("") + '<div class="row"><button class="btn pri" data-a="saveCo">Сохранить</button></div>';
}
function cardAction(btn, a){
  const card = btn.closest(".rq"), all = getReqs(), i = all.findIndex(r => r.id === card.dataset.id); if (i < 0) return;
  if (a === "del") {
    if (btn.dataset.sure !== "1") { btn.dataset.sure = "1"; btn.textContent = "Нажмите ещё раз: заявка и данные удалятся"; return; }
    all.splice(i, 1); putReqs(all); renderList(); return;
  }
  const f = k => card.querySelector('[data-f="' + k + '"]').value, err = card.querySelector("[data-e]"), st = f("status");
  if (st === "agreed" && (!f("final") || !f("at"))) { err.textContent = "Для статуса «Согласована» укажите цену и время"; return; }
  err.textContent = ""; all[i].hist.push(new Date().toLocaleString("ru-RU") + ": сохранено, статус «" + ST[st] + "»");
  Object.assign(all[i], {status: st, final: f("final"), at: f("at"), note: f("note")}); putReqs(all); renderList(); toast("Сохранено", false);
}
$("cab").addEventListener("click", e => {
  const el = e.target.closest("[data-a],[data-tab]"); if (!el) return;
  if (el.dataset.tab) { cab.tab = el.dataset.tab; renderCabinet(); return; }
  const a = el.dataset.a;
  if (a === "login") { if ($("cabPass").value === CONFIG.ownerPassword) { try { sessionStorage.setItem(KEY + ":auth", "1"); } catch(x){} renderCabinet(); } else $("cabErr").textContent = "Неверный пароль"; }
  else if (a === "logout") { try { sessionStorage.removeItem(KEY + ":auth"); } catch(x){} renderCabinet(); }
  else if (a === "refresh") renderList();
  else if (a === "saveTar") {
    const inp = document.querySelectorAll("#cabBody [data-p]"); let bad = false;
    inp.forEach(x => { if (x.value === "" || +x.value < 0) bad = true; });
    if (bad) { $("tarErr").textContent = "Заполните все поля числами от нуля"; return; }
    inp.forEach(x => { const p = x.dataset.p.split("."); if (p[1]) CONFIG.prices[p[0]][p[1]] = +x.value; else CONFIG[p[0]] = +x.value; });
    saveCfg(); renderPicker(); renderCart(); renderTariffs(); toast("Тарифы сохранены в этом браузере", false);
  }
  else if (a === "saveCo") { document.querySelectorAll("#cabBody [data-c]").forEach(x => CONFIG[x.dataset.c] = x.value.trim()); saveCfg(); applyCompany(); toast("Сохранено", false); }
  else if (a === "save" || a === "del") cardAction(el, a);
});
$("cab").addEventListener("input", e => { if (e.target.id === "cabQ") { cab.q = e.target.value; renderList(); } });
$("cab").addEventListener("change", e => { if (e.target.id === "cabS") { cab.s = e.target.value; renderList(); } });

// ---------- Компания и маршруты ----------
const DEFAULT_DESC = document.querySelector('meta[name="description"]').content, TITLES = {raschet: "Расчёт стоимости", tarify: "Тарифы", zayavka: "Заявка", kabinet: "Кабинет"};
function applyCompany(){
  $("brandName").textContent = CONFIG.company; $("tag").textContent = CONFIG.tagline + " " + CONFIG.city + ".";
  $("outLbl").textContent = "Выезд за город (+" + rub(CONFIG.outTown) + ")"; $("contacts").textContent = CONFIG.contacts;
  $("seoLinks").innerHTML = Object.keys(SEO).map(k => '<a href="#' + k + '">' + SEO[k].h1 + "</a>").join("");
}
function route(){
  const name = location.hash.slice(1) || "raschet", seo = SEO[name], view = seo ? "seo" : (TITLES[name] ? name : "raschet");
  document.body.dataset.view = view;
  document.querySelectorAll("[data-view]").forEach(el => el.hidden = el.dataset.view !== view);
  document.querySelectorAll("#nav a").forEach(a => { if (a.getAttribute("href") === "#" + view) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current"); });
  if (view === "tarify") renderTariffs(); else if (view === "kabinet") renderCabinet(); else if (seo) renderSeo(name, seo);
  document.title = (seo ? seo.h1 : TITLES[view]) + " — " + CONFIG.company;
  document.querySelector('meta[name="description"]').content = seo ? seo.desc : DEFAULT_DESC;
  window.scrollTo(0, 0); resize();
}
window.addEventListener("hashchange", route);

// ---------- Старт ----------
load(); loadCfg(); applyCompany();
$("outLbl").textContent = "Выезд за город (+" + rub(CONFIG.outTown) + ")"; $("contacts").textContent = CONFIG.contacts;
if (!CATS[S.cat]) { S.cat = "sofa"; S.v = "s2"; }
restoreDraft(); renderPicker(); renderCart(); initGL(); route();

// ---------- PWA: установка и офлайн-оболочка ----------
if ("serviceWorker" in navigator && location.protocol.startsWith("http")) {
  window.addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
}
let deferredInstallPrompt = null;
const installButton = $("installApp");
window.addEventListener("beforeinstallprompt", e => {
  e.preventDefault(); deferredInstallPrompt = e; installButton.hidden = false;
});
installButton.addEventListener("click", async () => {
  if (!deferredInstallPrompt) return;
  deferredInstallPrompt.prompt();
  await deferredInstallPrompt.userChoice;
  deferredInstallPrompt = null; installButton.hidden = true;
});
window.addEventListener("appinstalled", () => { installButton.hidden = true; });
</script>
</body>
</html>
