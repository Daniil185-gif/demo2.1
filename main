<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ---------- Настройки компании (меняются здесь) ----------
const CONFIG = {
  company: "Облако", city: "Ваш город",
  tagline: "Выберите мебель, посмотрите примерную цену и отправьте заявку.",
  contacts: "Контакты: укажите телефон и мессенджер в CONFIG.contacts",
  prices: {
    sofa: {s2: 3500, s3: 4500, corner: 6500},
    armchair: {std: 1500, recl: 2200},
    mattress: {single: 2000, double: 3000},
    chair: {seat: 400, back: 700}
  },
  minOrder: 2500,      // минимум относится к чистке, выезд за город добавляется отдельно
  heavyPct: 25,        // сильные загрязнения, процент к цене позиции
  secondSidePct: 40,   // вторая сторона матраса, процент к цене позиции
  outTown: 700,        // фиксированная доплата за выезд за город
  ownerPassword: "owner" // ДЕМО: настоящий вход проверяет сервер
};
// Порядок: цена варианта × (1 + загрязнение) × (1 + вторая сторона), округление до 10 ₽ за единицу, затем × количество.

const CATS = {
  sofa: {name: "Диван", vars: [["s2", "2 места"], ["s3", "3 места"], ["corner", "Угловой"]], color: 0x3a8a78},
  armchair: {name: "Кресло", vars: [["std", "Обычное"], ["recl", "Реклайнер"]], color: 0xe0a030},
  mattress: {name: "Матрас", vars: [["single", "Односпальный"], ["double", "Двуспальный"]], color: 0x8aa4e0},
  chair: {name: "Стул", vars: [["seat", "Сиденье"], ["back", "Сиденье со спинкой"]], color: 0xe06a58},
  other: {name: "Другое", vars: [], color: 0x9a6bb0}
};
const $ = id => document.getElementById(id);
const rub = n => n.toLocaleString("ru-RU") + " ₽";
const hex = c => "#" + c.toString(16).padStart(6, "0");
const KEY = "oblako:v1";
let S = {cart: [], draft: {}, cat: "sofa", v: "s2", heavy: false, side2: false};
function load(){ try { const r = JSON.parse(localStorage.getItem(KEY) || "null"); if (r) S = Object.assign(S, r); } catch(e){} }
function save(){ try { localStorage.setItem(KEY, JSON.stringify(S)); } catch(e){} }

// ---------- Расчёт ----------
function unitPrice(it){
  if (it.cat === "other") return null;
  let p = CONFIG.prices[it.cat][it.v];
  if (it.heavy) p *= 1 + CONFIG.heavyPct / 100;
  if (it.cat === "mattress" && it.side2) p *= 1 + CONFIG.secondSidePct / 100;
  return Math.round(p / 10) * 10;
}
function totals(){
  let known = 0, manual = 0;
  S.cart.forEach(it => { const u = unitPrice(it); if (u === null) manual += it.qty; else known += u * it.qty; });
  const cleaning = known > 0 ? Math.max(known, CONFIG.minOrder) : 0, out = $("out").checked ? CONFIG.outTown : 0;
  return {known, manual, cleaning, out, sum: cleaning + out};
}
function totalText(T){ return T.manual ? (T.sum ? "от " + rub(T.sum) + " + по фото" : "По фото") : rub(T.sum); }
function itemLabel(it){
  const c = CATS[it.cat];
  if (it.cat === "other") return "Другое: " + it.text;
  return c.name + ", " + c.vars.find(x => x[0] === it.v)[1] + (it.heavy ? ", сильные загрязнения" : "") + (it.side2 ? ", обе стороны" : "");
}

// ---------- Выбор ----------
function renderPicker(){
  $("cats").innerHTML = ""; $("vars").innerHTML = "";
  Object.keys(CATS).forEach(k => {
    const b = document.createElement("button"); b.className = "tab cat"; b.type = "button"; b.innerHTML = '<span class="ic">' + ICON[k] + "</span><span>" + CATS[k].name + "</span>";
    b.setAttribute("aria-pressed", String(S.cat === k));
    b.onclick = () => { S.cat = k; S.v = CATS[k].vars[0] ? CATS[k].vars[0][0] : "other"; S.side2 = false; renderPicker(); showModel(); save(); };
    $("cats").appendChild(b);
  });
  CATS[S.cat].vars.forEach(([k, n]) => {
    const b = document.createElement("button"); b.className = "tab"; b.type = "button"; b.textContent = n;
    b.setAttribute("aria-pressed", String(S.v === k));
    b.onclick = () => { S.v = k; renderPicker(); showModel(); save(); };
    $("vars").appendChild(b);
  });
  const other = S.cat === "other"; $("otherBox").hidden = !other; $("opts").innerHTML = "";
  if (!other) {
    $("opts").insertAdjacentHTML("beforeend", '<label class="chk"><input type="checkbox" id="heavy"' + (S.heavy ? " checked" : "") + '> <span>Сильные загрязнения</span></label>');
    if (S.cat === "mattress") $("opts").insertAdjacentHTML("beforeend", '<label class="chk"><input type="checkbox" id="side2"' + (S.side2 ? " checked" : "") + '> <span>Чистка второй стороны</span></label>');
    $("heavy").onchange = e => { S.heavy = e.target.checked; applyDirt(); renderPrice(); save(); };
    if ($("side2")) $("side2").onchange = e => { S.side2 = e.target.checked; renderPrice(); save(); };
  }
  renderPrice();
}
function renderPrice(){
  const vv = CATS[S.cat].vars.find(x => x[0] === S.v); $("badge").textContent = CATS[S.cat].name + (vv ? ", " + vv[1] : "");
  if (S.cat === "other") { $("unit").textContent = "По фото"; $("unitNote").textContent = "Цену назовёт мастер"; return; }
  $("unit").textContent = "≈ " + rub(unitPrice({cat: S.cat, v: S.v, heavy: S.heavy, side2: S.side2})); $("unitNote").textContent = "Примерно за единицу";
}
$("add").onclick = () => {
  if (S.cat === "other") {
    const t = $("otherText").value.trim();
    if (!t) { $("otherErr").textContent = "Опишите предмет, чтобы мастер мог оценить работу"; return; }
    $("otherErr").textContent = ""; S.cart.push({cat: "other", v: "other", text: t, qty: 1}); $("otherText").value = "";
  } else {
    const side = S.cat === "mattress" && S.side2;
    const same = S.cart.find(i => i.cat === S.cat && i.v === S.v && !!i.heavy === S.heavy && !!i.side2 === side);
    if (same) same.qty++; else S.cart.push({cat: S.cat, v: S.v, heavy: S.heavy, side2: side, qty: 1});
  }
  renderCart(); save(); toast("Добавлено в заказ", false);
};

// ---------- Корзина ----------
let lastRemoved = null, toastTimer;
function toast(msg, undo){
  $("toastMsg").textContent = msg; $("undo").style.display = undo ? "" : "none"; $("toast").style.display = "flex";
  clearTimeout(toastTimer); toastTimer = setTimeout(() => { $("toast").style.display = "none"; lastRemoved = null; }, 5000);
}
$("undo").onclick = () => { if (lastRemoved) { S.cart.splice(lastRemoved.i, 0, lastRemoved.it); lastRemoved = null; renderCart(); save(); } $("toast").style.display = "none"; };
function renderCart(){
  const box = $("cart");
  if (!S.cart.length) box.innerHTML = '<p class="note">Пока пусто. Выберите мебель и нажмите «Добавить в заказ».</p>';
  else {
    box.innerHTML = "";
    S.cart.forEach((it, i) => {
      const u = unitPrice(it), row = document.createElement("div"); row.className = "item";
      const info = document.createElement("div"), t = document.createElement("div"), d = document.createElement("i"), p = document.createElement("div");
      d.className = "dot"; d.innerHTML = ICON[it.cat]; t.append(d, itemLabel(it));
      p.className = "note"; p.textContent = u === null ? "По фото" : rub(u) + " × " + it.qty + " = " + rub(u * it.qty);
      info.append(t, p);
      const q = document.createElement("div"); q.className = "qty";
      if (it.cat !== "other") q.innerHTML = '<button class="btn sm" data-a="dec" data-i="' + i + '" aria-label="Меньше">−</button><b>' + it.qty + '</b><button class="btn sm" data-a="inc" data-i="' + i + '" aria-label="Больше">+</button>';
      q.insertAdjacentHTML("beforeend", '<button class="btn sm" data-a="del" data-i="' + i + '">Удалить</button>');
      row.append(info, q); box.appendChild(row);
    });
    const T = totals(), tt = document.createElement("div"); tt.className = "row";
    let h = "<div>";
    if (T.known > 0) h += "<div>Чистка: " + rub(T.cleaning) + (T.cleaning > T.known ? " (минимальный заказ)" : "") + "</div>";
    if (T.out) h += "<div>Выезд за город: " + rub(T.out) + "</div>";
    if (T.manual) h += "<div>Предметов по фото: " + T.manual + ", цену назовёт мастер</div>";
    tt.innerHTML = h + '</div><div class="price">' + totalText(T) + "</div>"; box.appendChild(tt);
  }
  renderSummary();
}
$("cart").onclick = e => {
  const b = e.target.closest("button[data-a]"); if (!b) return;
  const i = +b.dataset.i, it = S.cart[i], a = b.dataset.a;
  if (a === "inc") it.qty++; else if (a === "dec") { if (it.qty > 1) it.qty--; }
  else if (a === "del") { lastRemoved = {i, it}; S.cart.splice(i, 1); toast("Позиция удалена", true); }
  renderCart(); save();
};
function renderSummary(){
  const T = totals(), n = S.cart.reduce((s, i) => s + i.qty, 0);
  $("sumLine").textContent = S.cart.length ? "Предметов: " + n + (T.manual ? "" : ", итого " + rub(T.sum)) : "Добавьте хотя бы одну позицию";
  $("send").disabled = !S.cart.length || submittingRequest; $("bar").hidden = !S.cart.length;
  $("barN").textContent = "Предметов: " + n; $("barP").textContent = totalText(T);
  $("zsum").textContent = S.cart.length ? "Ваш заказ: " + S.cart.map(i => itemLabel(i) + (i.cat === "other" ? "" : " × " + i.qty)).join("; ") + ". Итого " + totalText(T) + "." : "Заказ пуст. Вернитесь к расчёту и добавьте мебель.";
}

// ---------- Форма ----------
const F = ["name", "phone", "addr", "date", "time", "comm"];
let pendingPhotos = [], submittingRequest = false;
function restoreDraft(){ F.forEach(k => { if (S.draft[k]) $(k).value = S.draft[k]; }); $("out").checked = !!S.draft.out; $("agree").checked = !!S.draft.agree; }
function saveDraft(){ F.forEach(k => S.draft[k] = $(k).value); S.draft.out = $("out").checked; S.draft.agree = $("agree").checked; save(); }
document.querySelectorAll("#form input:not([type=file]),#form textarea").forEach(el => el.addEventListener("input", saveDraft));
function photoData(file){ return new Promise((resolve,reject)=>{ const reader=new FileReader(); reader.onerror=reject; reader.onload=()=>{ const img=new Image(); img.onerror=reject; img.onload=()=>{ const max=1200, scale=Math.min(1,max/Math.max(img.width,img.height)), c=document.createElement("canvas"); c.width=Math.round(img.width*scale); c.height=Math.round(img.height*scale); c.getContext("2d").drawImage(img,0,0,c.width,c.height); resolve(c.toDataURL("image/jpeg",.76)); }; img.src=reader.result; }; reader.readAsDataURL(file); }); }
function renderPhotoPreview(){ const box=$("photoPreview"); box.innerHTML=""; pendingPhotos.forEach((src,i)=>{ const wrap=document.createElement("div"); wrap.className="photo-thumb"; const img=document.createElement("img"); img.src=src; img.alt="Фото мебели "+(i+1); const del=document.createElement("button"); del.type="button"; del.textContent="×"; del.setAttribute("aria-label","Удалить фото"); del.onclick=()=>{pendingPhotos.splice(i,1);renderPhotoPreview();}; wrap.append(img,del); box.appendChild(wrap); }); }
$("photos").addEventListener("change", async e=>{ const files=Array.from(e.target.files||[]); $("photoErr").textContent=""; if(files.length+pendingPhotos.length>3){$("photoErr").textContent="Можно прикрепить не более 3 фотографий";e.target.value="";return;} try{ for(const file of files){ if(!file.type.startsWith("image/")) continue; if(file.size>12*1024*1024) throw new Error("Каждое фото должно быть меньше 12 МБ"); pendingPhotos.push(await photoData(file)); } renderPhotoPreview(); }catch(err){$("photoErr").textContent=err.message||"Не удалось обработать фотографию";} e.target.value=""; });
$("out").addEventListener("change", () => { saveDraft(); renderCart(); });
$("send").onclick = () => {
  if (submittingRequest) return;
  const err = {}, digits = $("phone").value.replace(/\D/g, "");
  if (!$("name").value.trim()) err.name = "Укажите имя";
  if (digits.length < 10) err.phone = "Введите телефон полностью, не меньше 10 цифр";
  if (!$("addr").value.trim()) err.addr = "Укажите адрес, куда приехать";
  if ($("time").value && !$("date").value) err.time = "Для времени выберите дату";
  if (!$("agree").checked) err.agree = "Нужно согласие на обработку данных";
  ["name", "phone", "addr", "time", "agree"].forEach(k => $("e-" + k).textContent = err[k] || "");
  const bad = Object.keys(err)[0]; if (bad) { (bad === "agree" ? $("agree") : $(bad)).focus(); return; }
  const T = totals(), L = [CONFIG.company + ": заявка на чистку", ""];
  S.cart.forEach(it => { const u = unitPrice(it); L.push("• " + itemLabel(it) + (u === null ? " (по фото)" : " × " + it.qty + " = " + rub(u * it.qty))); });
  L.push("", "Предварительно: " + totalText(T) + (T.known && T.cleaning > T.known ? " (применён минимум)" : ""));
  if (T.out) L.push("Выезд за город: " + rub(T.out));
  L.push("", "Имя: " + $("name").value.trim(), "Телефон: " + $("phone").value.trim(), "Адрес: " + $("addr").value.trim());
  if ($("date").value) L.push("Желаемо: " + $("date").value + ($("time").value ? " " + $("time").value : ""));
  if ($("comm").value.trim()) L.push("Комментарий: " + $("comm").value.trim());
  if (pendingPhotos.length) L.push("Фотографий приложено: " + pendingPhotos.length);
  L.push("", "Итоговую цену и время согласует мастер.");
  const key = L.join("|") + "|photos:" + pendingPhotos.map(p => p.slice(-72)).join(","), reqs = getReqs();
  if (!reqs.some(r => r.key === key)) { const created = new Date(); reqs.unshift({id: created.getTime().toString(36) + Math.random().toString(36).slice(2, 6), key: key, createdAt: created.toISOString(), name: $("name").value.trim(), phone: $("phone").value.trim(), addr: $("addr").value.trim(), out: $("out").checked, date: $("date").value, time: $("time").value, comm: $("comm").value.trim(), photos: pendingPhotos.slice(), items: JSON.parse(JSON.stringify(S.cart)), est: totalText(T), status: "new", final: "", at: "", note: "", hist: [created.toLocaleString("ru-RU") + ": заявка создана"]}); putReqs(reqs); }
  submittingRequest = true; $("send").disabled = true; $("send").textContent = "Заявка уже создана";
  $("resText").textContent = L.join("\n"); $("result").hidden = false; $("result").scrollIntoView({block: "nearest"});
};
$("newRequest").onclick = () => {
  F.forEach(k => { $(k).value = ""; }); $("out").checked = false; $("agree").checked = false;
  pendingPhotos = []; $("photos").value = ""; renderPhotoPreview(); $("photoErr").textContent = "";
  ["name", "phone", "addr", "time", "agree"].forEach(k => $("e-" + k).textContent = "");
  S.draft = {}; save(); submittingRequest = false; $("send").disabled = !S.cart.length; $("send").textContent = "Отправить заявку"; $("result").hidden = true; $("form").scrollIntoView({block: "start"});
};
$("copy").onclick = async () => { try { await navigator.clipboard.writeText($("resText").textContent); toast("Скопировано", false); } catch(e) { toast("Не удалось скопировать, выделите текст вручную", false); } };

// Используется только светлая тема.

// ---------- 3D ----------
let R = null, zoom = 1, floor, group, TEX = [], yaw = .5, pitch = .25, tYaw = .5, tPitch = .25, drag = false, lx = 0, ly = 0, popT = 1;
function fabricBumpTex(seed){
  let s = seed; const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;
  const c = document.createElement("canvas"); c.width = c.height = 512;
  const g = c.getContext("2d"); g.fillStyle = "#888"; g.fillRect(0,0,512,512);
  for(let y=0;y<512;y+=3){
    g.fillStyle = "rgba(255,255,255," + (.035+rnd()*.035) + ")";
    g.fillRect(0,y,512,1);
    g.fillStyle = "rgba(0,0,0," + (.025+rnd()*.03) + ")";
    g.fillRect(0,y+1,512,1);
  }
  for(let i=0;i<18000;i++){
    const v = rnd()>.5 ? 255 : 20;
    g.fillStyle = "rgba("+v+","+v+","+v+",.10)";
    g.fillRect(rnd()*512,rnd()*512,1+rnd()*2,1);
  }
  const t = new THREE.CanvasTexture(c); t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(2.5,2.5); t.anisotropy=4; return t;
}
function dirtTex(seed){
  let s = seed; const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;
  const c = document.createElement("canvas"); c.width = c.height = 256; const g = c.getContext("2d");
  g.fillStyle = "#8e7968"; g.fillRect(0, 0, 256, 256);
  for (let i = 0; i < 7; i++) {
    const x = rnd() * 256, y = rnd() * 256, rx = 18 + rnd() * 42, ry = 12 + rnd() * 34, gr = g.createRadialGradient(x, y, 2, x, y, Math.max(rx, ry));
    gr.addColorStop(0, "rgba(48,31,24,.92)"); gr.addColorStop(.42, "rgba(67,45,32,.78)"); gr.addColorStop(.78, "rgba(111,75,49,.52)"); gr.addColorStop(1, "rgba(111,75,49,0)");
    g.save(); g.translate(x,y); g.scale(rx/Math.max(rx,ry),ry/Math.max(rx,ry)); g.fillStyle=gr; g.beginPath(); g.arc(0,0,Math.max(rx,ry),0,Math.PI*2); g.fill(); g.restore();
  }
  for (let i = 0; i < 95; i++) { g.fillStyle = "rgba(45,31,25," + (.18 + rnd() * .5) + ")"; g.beginPath(); g.ellipse(rnd()*256,rnd()*256,1+rnd()*5,.8+rnd()*2,rnd()*3,0,Math.PI*2); g.fill(); }
  return new THREE.CanvasTexture(c);
}
function applyDirt(){
  if (!group || !TEX.length) return;
  group.userData.fab.forEach((m, i) => { m.map = S.heavy && S.cat !== "other" ? TEX[i % 3] : null; m.needsUpdate = true; });
}
function initGL(){
  try {
    if (!window.THREE) throw 0;
    const probe = document.createElement("canvas"); if (!(probe.getContext("webgl") || probe.getContext("experimental-webgl"))) throw 0;
    const r = new THREE.WebGLRenderer({antialias: true, alpha: true, powerPreference: "high-performance"});
    r.setPixelRatio(Math.min(devicePixelRatio || 1, 2)); r.outputEncoding = THREE.sRGBEncoding; r.toneMapping = THREE.ACESFilmicToneMapping; r.toneMappingExposure = .92; r.shadowMap.enabled = true; r.shadowMap.type = THREE.PCFSoftShadowMap;
    $("stage").insertBefore(r.domElement, $("stage").firstChild);
    const scene = new THREE.Scene(), cam = new THREE.PerspectiveCamera(34, 1, 2, 30);
    scene.add(new THREE.HemisphereLight(0xffffff, 0x758493, .78));
    const d = new THREE.DirectionalLight(0xfff4e8, 1.05); d.position.set(3.5, 6, 4); d.castShadow = true;
    d.shadow.mapSize.set(1024, 1024); Object.assign(d.shadow.camera, {left: -4, right: 4, top: 4, bottom: -4, near: .5, far: 16}); d.shadow.bias = -.0004; d.shadow.normalBias = .03; scene.add(d);
    const f = new THREE.DirectionalLight(0x9ec9e8, .38); f.position.set(-4, 3, -3); scene.add(f);
    const rim = new THREE.DirectionalLight(0xffffff, .28); rim.position.set(1, 4, -5); scene.add(rim);
    floor = new THREE.Mesh(new THREE.PlaneGeometry(200, 200), new THREE.MeshStandardMaterial({color: 0xcbd9e3, roughness: 1})); floor.rotation.x = -Math.PI / 2; floor.position.y = -.015; floor.receiveShadow = true; scene.add(floor);
    TEX = [dirtTex(11), dirtTex(23), dirtTex(37)];
    R = {r, scene, cam}; recolor(); resize(); new ResizeObserver(resize).observe($("stage"));
    const st = $("stage");
    st.addEventListener("pointerdown", e => { drag = true; lx = e.clientX; ly = e.clientY; st.setPointerCapture(e.pointerId); st.style.cursor = "grabbing"; });
    st.addEventListener("pointermove", e => { if (!drag) return; tYaw += (e.clientX - lx) * .01; tPitch = Math.max(.05, Math.min(.7, tPitch + (e.clientY - ly) * .006)); lx = e.clientX; ly = e.clientY; });
    ["pointerup", "pointercancel"].forEach(n => st.addEventListener(n, () => { drag = false; st.style.cursor = "grab"; }));
    st.addEventListener("dblclick", () => { tYaw = .5; tPitch = .25; });
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    (function loop(){
      requestAnimationFrame(loop); if (document.hidden || !st.offsetParent) return;
      if (!drag && !reduce) tYaw += .002;
      yaw += (tYaw - yaw) * .15; pitch += (tPitch - pitch) * .15; popT = Math.min(1, popT + .06);
      if (group) { group.rotation.y = yaw; const s = .85 + .15 * popT; group.scale.set(s, s, s); }
      cam.position.set(0, 1.4 + pitch * 4, (7.4 - pitch * 2) * zoom); cam.lookAt(0, .85, 0);
      if (group && group.userData.eyes) { const bl = (performance.now() % 4200) < 140 ? .1 : 1; group.userData.eyes.forEach(e => e.scale.y = bl); }
      r.render(scene, cam);
    })();
    showModel();
  } catch(e) { R = null; $("poster").style.display = "flex"; }
}
function resize(){ if (!R) return; const w = $("stage").clientWidth, h = $("stage").clientHeight; if (!w || !h) return; R.r.setSize(w, h, false); R.cam.aspect = w / h; zoom = Math.max(1, 1.5 / (w / h)); R.cam.updateProjectionMatrix(); }
function recolor(){ if (floor) floor.material.color.set(0xcbd9e3); }

function rb(w, h, d, r, seg){
  seg = seg || 8;
  const g = new THREE.BoxGeometry(w, h, d, seg, seg, seg), p = g.attributes.position, n = g.attributes.normal;
  const hx = w / 2 - r, hy = h / 2 - r, hz = d / 2 - r, v = new THREE.Vector3(), c = new THREE.Vector3();
  for (let i = 0; i < p.count; i++) {
    v.fromBufferAttribute(p, i);
    c.set(Math.max(-hx, Math.min(hx, v.x)), Math.max(-hy, Math.min(hy, v.y)), Math.max(-hz, Math.min(hz, v.z)));
    v.sub(c).normalize(); n.setXYZ(i, v.x, v.y, v.z); p.setXYZ(i, c.x + v.x * r, c.y + v.y * r, c.z + v.z * r);
  }
  return g;
}
function put(g, geo, mat, x, y, z, rx, rz){ const o = new THREE.Mesh(geo, mat); o.position.set(x, y, z); if (rx) o.rotation.x = rx; if (rz) o.rotation.z = rz; o.castShadow = true; o.receiveShadow = true; g.add(o); return o; }
function legs(g, mat, pts, h){ pts.forEach(q => put(g, new THREE.CylinderGeometry(.07, .045, h, 14), mat, q[0], h / 2, q[1], q[1] * .12, -q[0] * .05)); }
// Лицо крепится к самой детали (par), поэтому наклоняется вместе с ней и не «висит» в воздухе.
function face(par, root, x, y, z, s){
  const ink = new THREE.MeshStandardMaterial({color: 0x182226, roughness: .25}), shine = new THREE.MeshBasicMaterial({color: 0xffffff});
  const line = new THREE.MeshBasicMaterial({color: 0x182226}), pink = new THREE.MeshBasicMaterial({color: 0xff8f9c, transparent: true, opacity: .6, polygonOffset: true, polygonOffsetFactor: -4, polygonOffsetUnits: -4});
  root.userData.mats.push(ink, shine, line, pink);
  const eyes = root.userData.eyes = [];
  [-1, 1].forEach(k => {
    const e = new THREE.Group(); e.position.set(x + k * .2 * s, y, z);
    const ball = new THREE.Mesh(new THREE.SphereGeometry(.06 * s, 18, 14), ink); ball.scale.set(1, 1.35, .55); e.add(ball);
    const hl = new THREE.Mesh(new THREE.SphereGeometry(.018 * s, 8, 6), shine); hl.position.set(.016 * s, .032 * s, .03 * s); e.add(hl);
    par.add(e); eyes.push(e);
    const ch = new THREE.Mesh(new THREE.CircleGeometry(.06 * s, 20), pink); ch.scale.x = 1.4; ch.position.set(x + k * .3 * s, y - .08 * s, z + .006); par.add(ch);
  });
  const sm = new THREE.Mesh(new THREE.TorusGeometry(.05 * s, .011 * s, 8, 16, Math.PI), line); sm.rotation.z = Math.PI; sm.position.set(x, y - .04 * s, z + .008); par.add(sm);
}
// Размеры подобраны так, чтобы грани соседних деталей не лежали в одной плоскости (иначе текстуры мерцают).
function buildModel(cat, v){
  const col = CATS[cat].color, mk = (c, r) => new THREE.MeshStandardMaterial({color: c, roughness: r || .82, metalness: .01});
  const base = new THREE.Color(col).multiplyScalar(1.12);
  const M = mk(base, .88), D = mk(new THREE.Color(col).multiplyScalar(.66), .9), L = mk(new THREE.Color(col).lerp(new THREE.Color(0xffffff), .18), .94), W = mk(0x60432f, .52), B = mk(new THREE.Color(col).multiplyScalar(.43), .62);
  const weave = fabricBumpTex(cat === "sofa" ? 17 : cat === "armchair" ? 29 : cat === "mattress" ? 41 : 53);
  [M,D,L].forEach(m => { m.bumpMap = weave; m.bumpScale = .045; m.roughness = .96; });
  const g = new THREE.Group(); g.userData.mats = [M, D, L, W, B]; g.userData.fab = [M, L, D];
  const btn = new THREE.SphereGeometry(.04, 10, 8);
  if (cat === "sofa" || cat === "armchair") {
    const sofa = cat === "sofa", rec = v === "recl", corner = v === "corner";
    const n = !sofa ? 1 : (v === "s3" ? 3 : 2), cw = sofa ? 1.0 : 1.05, seatW = n * cw, arm = .34, w = seatW + 2 * arm, tilt = rec ? .34 : .12;
    put(g, rb(w - .04, .36, 1.24, .08), D, 0, .42, 0);
    for (let i = 0; i < n; i++) {
      const sx = (i - (n - 1) / 2) * cw;
      put(g, rb(cw - .03, .3, 1.0, .13, 14), M, sx, .76, .1);
      const piping = new THREE.MeshStandardMaterial({color:new THREE.Color(col).multiplyScalar(.72),roughness:.78});
      g.userData.mats.push(piping);
      const seam = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3([
        new THREE.Vector3(sx-cw*.39,.89,.59),new THREE.Vector3(sx,.89,.61),new THREE.Vector3(sx+cw*.39,.89,.59)
      ]),28,.012,8,false),piping);
      seam.castShadow=true; g.add(seam);
    }
    const nb = n === 3 ? 3 : 1, bw = seatW / nb; let host = null;
    for (let i = 0; i < nb; i++) { const bc = put(g, rb(bw - .03, .84, .34, .15), L, (i - (nb - 1) / 2) * bw, 1.2, -.42, -tilt); if (i === (nb - 1) / 2) host = bc; }
    put(g, rb(w - .06, 1.1, .3, .1), D, 0, 1.0, -.6, rec ? -.2 : 0);
    put(g, rb(arm, .8, 1.3, .16), M, -(seatW / 2 + arm / 2), .68, 0);
    if (corner) {
      put(g, rb(arm, .8, 2.5, .16), M, seatW / 2 + arm / 2, .68, .6);
      put(g, rb(cw, .36, 1.16, .08), D, seatW / 2 - cw / 2, .42, 1.25);
      put(g, rb(cw - .03, .3, 1.1, .13), M, seatW / 2 - cw / 2, .76, 1.2);
      legs(g, W, [[w / 2 - .2, 1.6], [seatW / 2 - cw + .2, 1.6]], .26);
    } else put(g, rb(arm, .8, 1.3, .16), M, seatW / 2 + arm / 2, .68, 0);
    if (rec) put(g, rb(cw, .24, .8, .1), L, 0, .5, 1.0, -.12);
    legs(g, W, [[-w / 2 + .2, .5], [w / 2 - .2, .5], [-w / 2 + .2, -.5], [w / 2 - .2, -.5]], .26);
    face(host, g, 0, .14, .17, sofa ? 1 : .85);
  } else if (cat === "mattress") {
    const w = v === "double" ? 2.1 : 1.35, h = 2.1, d = .42, cols = v === "double" ? 5 : 3, rows = 6, cy = h / 2 + .05;
    put(g, rb(w + .1, .05, d + .5, .02), W, 0, .025, 0);
    const bd = put(g, rb(w, h, d, .14, 10), M, 0, cy, 0);
    put(g, rb(w + .04, .06, d + .04, .03), L, 0, h + .05, 0); put(g, rb(w + .04, .06, d + .04, .03), L, 0, .05, 0);
    [-1, 1].forEach(k => put(g, rb(.06, h + .12, d + .05, .03), L, k * w / 2, cy, 0));
    [-1, 1].forEach(s => { for (let i = 1; i < cols; i++) for (let j = 1; j < rows; j++) {
      const x = -w / 2 + i * w / cols, y = .05 + j * h / rows; if (s === 1 && y > 1.3 && y < 1.95) continue;
      put(g, btn, B, x, y, s * (d / 2 + .005)); } });
    const hd = put(g, new THREE.TorusGeometry(.09, .022, 8, 16), L, w / 2 + .05, 1.2, 0); hd.rotation.y = Math.PI / 2;
    face(bd, g, 0, 1.62 - cy, d / 2, 1.3);
  } else if (cat === "chair") {
    const back = v === "back";
    put(g, rb(1.1, .16, 1.1, .07), D, 0, .82, 0);
    const cu = put(g, rb(1.04, back ? .2 : .3, 1.04, .1), M, 0, back ? .98 : 1.0, 0);
    legs(g, W, [[-.42, -.42], [.42, -.42], [-.42, .42], [.42, .42]], .8);
    if (back) {
      [-1, 1].forEach(k => put(g, new THREE.CylinderGeometry(.05, .05, 1.2, 10), W, k * .5, 1.4, -.46));
      const pn = put(g, rb(1.04, .9, .14, .07), M, 0, 1.55, -.46); face(pn, g, 0, .03, .07, .8);
    } else face(cu, g, 0, 0, .52, .6);
  } else {
    const bd = put(g, rb(1.5, .9, 1.5, .38, 12), M, 0, .55, 0); put(g, btn, B, 0, 1.0, 0);
    legs(g, W, [[-.5, -.5], [.5, -.5], [-.5, .5], [.5, .5]], .15);
    face(bd, g, 0, 0, .75, 1);
  }
  // Тонкая декоративная окантовка подчёркивает объём и отделяет мягкие детали.
  if (cat === "sofa" || cat === "armchair") {
    const stitchMat = new THREE.MeshStandardMaterial({color:new THREE.Color(col).multiplyScalar(.72),roughness:.9});
    g.userData.mats.push(stitchMat);
    for(let side of [-1,1]){
      const x = side * (seatW/2 + arm*.5);
      const line = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3([
        new THREE.Vector3(x,.35,.55),new THREE.Vector3(x,.36,.15),new THREE.Vector3(x,.35,-.48)
      ]),18,.009,6,false),stitchMat);
      line.castShadow=true; g.add(line);
    }
  }
  return g;
}
function showModel(){
  if (!R) return;
  if (group) { R.scene.remove(group); group.traverse(o => { if (o.geometry) o.geometry.dispose(); }); group.userData.mats.forEach(m => m.dispose()); }
  group = buildModel(S.cat, S.v); R.scene.add(group); popT = 0; applyDirt();
}

