};
const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"}[c]));
function loadCfg(){
  try { const o = JSON.parse(localStorage.getItem(KEY + ":cfg") || "null"); if (!o) return;
    Object.keys(o).forEach(k => { if (k === "prices") { for (const c in o.prices) Object.assign(CONFIG.prices[c], o.prices[c]); } else CONFIG[k] = o[k]; }); } catch(e){}
}
function saveCfg(){ try { localStorage.setItem(KEY + ":cfg", JSON.stringify(CONFIG)); } catch(e){} }

